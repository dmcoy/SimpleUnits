<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
	<PackageId>SimpleUnits</PackageId>
	<Version>1.1.0</Version>
	<Authors>dmcoy</Authors>
	<Description>A lightweight static class library for unit conversion in dotnet projects.</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/dmcoy/SimpleUnits</RepositoryUrl>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/dmcoy/SimpleUnits</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <Title>Simple Units</Title>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReleaseNotes>Added double/float extension methods for every conversion method across all unit types, added a full xUnit test suite, and fixed BaseUnitsMatch to throw a clear ArgumentException instead of a KeyNotFoundException for unregistered unit types.</PackageReleaseNotes>
    <PackageTags>units; unit; convert; conversion; metric; imperial;</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleUnits.Tests" />
  </ItemGroup>

</Project>
